<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Matikan auto-redirect /dir ke /dir/ oleh Apache
  DirectorySlash Off

  # 1. Jika request adalah file fisik yang nyata (gambar, php, js, css, html)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Hilangkan trailing slash (kecuali root /)
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^(.+)/$ $1 [R=301,L]

  # 3. Jika ada file .html yang cocok (misal: /id -> id.html, /id/akomodasi -> id/akomodasi.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 4. Jika direktori memiliki index.html (misal: /admin -> admin/index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # 5. Fallback 404
  ErrorDocument 404 /404.html
</IfModule>

# Cegah directory listing
Options -Indexes

# Header keamanan dasar
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
