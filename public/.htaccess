<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Jika request adalah file fisik yang nyata (gambar, file php, js, css)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Prioritaskan file .html meskipun ada direktori dengan nama yang sama
  # Contoh: /id -> id.html, /id/akomodasi -> id/akomodasi.html, /admin -> admin.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 3. Jika direktori memiliki index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 4. Fallback 404
  ErrorDocument 404 /404.html
</IfModule>

# Cegah directory listing
Options -Indexes

# Header keamanan dasar
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
